# ==============================================================================
# TAAZI TOKARI (ताज़ी टोकरी) - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real production credentials.
# NEVER commit real secret keys, service role keys, or database passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT & CLIENT URLS
# ------------------------------------------------------------------------------
VITE_APP_NAME="Taazi Tokari"
VITE_APP_TAGLINE="Kishan Fresh to Kitchen"
VITE_DEFAULT_CITY="Lucknow"
VITE_DEFAULT_STATE="Uttar Pradesh"

# ------------------------------------------------------------------------------
# 2. SUPABASE (Required for Production Database, Auth & Image Storage)
# - Provides PostgreSQL 16 database, Supabase Auth with Google OAuth, and S3 Storage.
# - Free tier: 500 MB DB, 50,000 monthly active users, 1 GB file storage.
# - Where to find: Supabase Dashboard -> Project Settings -> API.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-here"

# Server-side only secret key for migrations/seed (DO NOT prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CREDENTIALS (Required for One-Tap Customer Sign-In)
# - Enables seamless 1-click customer login without manual password creation.
# - Free tier: Free unlimited standard OAuth 2.0 authentications.
# - Where to configure: Google Cloud Console -> APIs & Services -> Credentials.
# - Authorized Redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback
# - Where to enter: Supabase Dashboard -> Authentication -> Providers -> Google.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ------------------------------------------------------------------------------
# 4. AUTHORIZED ADMINISTRATOR EMAILS (Required for Role Verification)
# - Comma-separated list of emails authorized to access the Admin Control Center.
# - Admin role is verified server-side and can NEVER be self-assigned by customers.
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAILS="admin@taazitokari.in,amit.sharma@taazitokari.in"

# ------------------------------------------------------------------------------
# 5. LOCATION & GEOCODING SERVICES
# - Browser Geolocation API: Free, keyless, built into all modern mobile/desktop browsers.
# - OpenStreetMap Nominatim (Default): Keyless, free reverse geocoding up to 1 req/sec.
# - Google Maps Platform (Optional alternative for autocomplete & interactive map):
#   Set VITE_GOOGLE_MAPS_API_KEY if choosing Google Maps over OpenStreetMap.
# ------------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY (Optional for Online Pre-Payments)
# - Enables UPI (GPay, PhonePe, Paytm), NetBanking, and RuPay card pre-orders.
# - Cash on Delivery (COD) works immediately with zero keys required.
# - Standard Razorpay pricing: 2% per successful transaction.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_for_webhooks"

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS (Optional Push Provider)
# - In-app announcements & banners work immediately without external keys.
# - Optional Web Push: Firebase Cloud Messaging (FCM) or OneSignal.
# ------------------------------------------------------------------------------
VITE_ONESIGNAL_APP_ID=""
