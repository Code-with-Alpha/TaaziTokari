# ==============================================================================
# ANTIGRAVITY / TAAZI TOKARI: ENVIRONMENT CONFIGURATION
# Lucknow Neighbourhood Fresh-Food Pre-Order Engine
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL 16 Connection
POSTGRES_USER=antigravity_admin
POSTGRES_PASSWORD=antigravity_secret_pass
POSTGRES_DB=antigravity_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://antigravity_admin:antigravity_secret_pass@localhost:5432/antigravity_db?schema=public"

# Redis 7 (BullMQ Midnight Cutoff & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=antigravity_redis_pass
REDIS_URL="redis://:antigravity_redis_pass@localhost:6379"

# Cryptography & Security
# 32-byte hex key for AES-256-GCM encryption of customer PII (phone, flat number, delivery notes)
ENCRYPTION_KEY_AES256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secret_jwt_access_token_lucknow_antigravity_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_lucknow_antigravity_2026
JWT_REFRESH_EXPIRATION=7d

# Payment Gateways (Razorpay & Cashfree)
RAZORPAY_KEY_ID=rzp_test_lucknow_avadh_mandi
RAZORPAY_KEY_SECRET=rzp_secret_dummy_lucknow_2026
RAZORPAY_WEBHOOK_SECRET=whsec_antigravity_midnight_cutoff_lucknow_sha256

# Operational Defaults
CUTOFF_CRON="0 0 * * *" # Daily 12:00:00 AM midnight
DEFAULT_CITY="Lucknow"
DEFAULT_DISPATCH_TIME="06:00" # Dawn procurement dispatch
DOORSTEP_PROMISE_TIME="10:11" # 10:11 AM doorstep delivery
