// ==============================================================================
// ANTIGRAVITY: PRODUCTION PRISMA SCHEMA
// Lucknow Neighbourhood Fresh-Food Pre-Order Engine
// "Order Tonight. Fresh Tomorrow Morning."
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  PROCUREMENT
  QC_OPERATIONS
  PACKING
  DELIVERY
  DIETICIAN
}

enum OrderStatus {
  CART
  PLACED_PENDING_PAYMENT
  LOCKED_FROZEN
  PROCESSING_QC
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum AuditAction {
  PRICE_MODIFICATION
  REFUND_ISSUED
  INVENTORY_OVERRIDE
  CUTOFF_TRIGGERED
  SOCIETY_ONBOARDED
  SECURITY_EVENT
}

model User {
  id            String      @id @default(uuid())
  phone         String      @unique // Encrypted at rest using AES-256
  name          String?
  role          Role        @default(CUSTOMER)
  societyId     String?
  society       Society?    @relation(fields: [societyId], references: [id])
  addresses     Address[]
  orders        Order[]
  auditLogs     AuditLog[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([role])
  @@index([societyId])
}

model Society {
  id           String   @id @default(uuid())
  name         String
  pincode      String
  city         String   @default("Lucknow")
  cutOffTime   String   @default("00:00") // Daily midnight cutoff
  users        User[]
  orders       Order[]
  createdAt    DateTime @default(now())

  @@index([pincode])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flatNumber    String   // Encrypted at rest using AES-256
  blockNumber   String
  landmark      String?
  isDefault     Boolean  @default(false)
  orders        Order[]

  @@index([userId])
}

model Product {
  id            String          @id @default(uuid())
  name          String
  hindiName     String?
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  unit          String          // kg, bunch, piece, 500g
  priceInPaise  Int             // Absolute integer paise (₹38.00 = 3800 paise)
  bufferPct     Float           @default(0.05) // SKU-specific buffer (e.g., 0.15 for 15%)
  isActive      Boolean         @default(true)
  orderItems    OrderItem[]
  procurements  ProcurementItem[]
  createdAt     DateTime        @default(now())

  @@index([categoryId])
  @@index([isActive])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // e.g., ORD-LKO-20261010-8492
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String
  address         Address       @relation(fields: [addressId], references: [id])
  societyId       String
  society         Society       @relation(fields: [societyId], references: [id])
  status          OrderStatus   @default(PLACED_PENDING_PAYMENT)
  totalInPaise    Int           // Absolute integer paise
  savingsInPaise  Int           @default(0) // Customer savings vs retail mandi benchmark
  paymentId       String?       // Razorpay/Cashfree transaction reference
  deliveryNotes   String?       // Encrypted customer delivery instructions
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([societyId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int      // Number of units ordered
  priceAtPurchase Int      // Snapshot unit price in paise at transaction time

  @@index([orderId])
  @@index([productId])
}

model ProcurementSheet {
  id             String            @id @default(uuid())
  date           DateTime          @db.Date
  status         String            @default("PENDING_CUTOFF") // PENDING_CUTOFF, DISPATCHED_MANDI, RECEIVED_QC, COMPLETED
  items          ProcurementItem[]
  createdAt      DateTime          @default(now())

  @@unique([date])
}

model ProcurementItem {
  id                   String           @id @default(uuid())
  procurementSheetId   String
  procurementSheet     ProcurementSheet @relation(fields: [procurementSheetId], references: [id], onDelete: Cascade)
  productId            String
  product              Product          @relation(fields: [productId], references: [id])
  totalCustomerDemand  Float            // Aggregated sum of household demand
  appliedBuffer        Float            // E.g., 0.15 (15%)
  finalProcureTarget   Float            // Demand * (1 + appliedBuffer)
  actualPurchasedQty   Float?           // Dawn mandi weighbridge actuals
  actualCostInPaise    Int?             // Real dawn mandi procurement cost in paise
  supplierName         String?          // Mandi Arhatiya / Farm collective name
  rejectedQty          Float            @default(0) // Rejected at 6:30 AM warehouse QC

  @@index([procurementSheetId])
  @@index([productId])
}

model AuditLog {
  id           String      @id @default(uuid())
  action       AuditAction
  entityName   String      // e.g. "Product", "Order", "Society"
  entityId     String?
  actorId      String
  actor        User        @relation(fields: [actorId], references: [id])
  details      Json
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
